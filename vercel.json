{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/wonder",
      "destination": "/wonder/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/wonder/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wonder/(.*).pck",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
